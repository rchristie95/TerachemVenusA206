! STEOM-DLPNO-CCSD def2-SVPD AutoAux RIJCOSX TightSCF TightPNO
# Same sweep at the correlated level. def2-SVPD is the production setting, so
# that job doubles as a reproducibility check on the published |mu| and site
# energy. TZVP may exhaust memory; the queue skips it if so.
%maxcore 5000
%pal nprocs 8 end
%pointcharges "field.pc"
%mdci
  NRoots 5
  DoRootWise true
  FollowCIS true
  RootHoming true
  CheckEachRoot true
  DTol 1e-5
  DoStoreSTEOM true
  AddL2Term True
  DoDbFilter true
  NRootsCISNAT 10
  TCutPNOSingles 1e-12
  NDav 400
  MaxIter 400
end
* xyzfile -1 1 geom_cthrp.xyz
