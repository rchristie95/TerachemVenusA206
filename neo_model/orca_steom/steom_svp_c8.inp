! STEOM-DLPNO-CCSD def2-SVP def2-SVP/C def2/J RIJCOSX TightSCF TightPNO
# Convergence-tuned: default EOM did NOT converge for this multi-reference anion
# (IP roots at 47-52% singles, residuals oscillate -> serial proceeds anyway, parallel aborts).
# Fix per ORCA 6.1 manual sec 5.13: tighten PNO singles + enlarge Davidson space + more iters.
%maxcore 4000
%pal nprocs 8 end
%pointcharges "field.pc"
%mdci
  NRoots 5
  DoRootWise true
  DoStoreSTEOM true
  AddL2Term True
  TCutPNOSingles 1e-12
  NDav 400
  MaxIter 200
end
* xyzfile -1 1 geom_cthrp.xyz
