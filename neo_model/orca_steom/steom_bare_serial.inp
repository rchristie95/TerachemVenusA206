! STEOM-DLPNO-CCSD def2-SVP def2-SVP/C def2/J RIJCOSX TightSCF TightPNO
# SERIAL: parallel EA-EOM "equations failed" on the bare anion (cyanine-like C-O 1.312).
# Serial tolerates the non-converged EA satellites (excluded from STEOM anyway) -> bright state.
%maxcore 16000
%pal nprocs 1 end
%mdci
  NRoots 3
  DoRootWise true
  DoStoreSTEOM true
  AddL2Term True
  TCutPNOSingles 1e-12
  NDav 400
  MaxIter 200
end
* xyzfile -1 1 cr2_chromophore.xyz
