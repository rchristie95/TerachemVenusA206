! STEOM-DLPNO-CCSD def2-SVP def2-SVP/C def2/J RIJCOSX TightSCF TightPNO
# HBDI-truncated neutral chromophore. Robust active-space settings, matching
# steom_neutral_check.inp exactly so the two are directly comparable.
%maxcore 6000
%pal nprocs 8 end
%mdci
  NRoots 5
  DoRootWise true
  FollowCIS true
  RootHoming true
  CheckEachRoot true
  DTol 1e-5
  DoStoreSTEOM true
  AddL2Term True
  DoDbFilter true
  NRootsCISNAT 10
  TCutPNOSingles 1e-12
  NDav 400
  MaxIter 400
end
* xyzfile 0 1 hbdi.xyz
